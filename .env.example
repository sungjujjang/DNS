# Discord 봇 토큰 (Discord Developer Portal > Bot)
DISCORD_TOKEN=

# 슬래시 커맨드를 즉시 반영할 테스트 서버 ID (미설정 시 글로벌 동기화)
DNS_GUILD_ID=

# 마스터 관리자 Discord ID
DNS_MASTER_ADMIN_ID=1337070890323673182

# MySQL 데이터베이스 설정
DNS_DB_HOST=127.0.0.1
DNS_DB_PORT=3306
DNS_DB_USER=
DNS_DB_PASSWORD=
DNS_DB_NAME=

# 개인정보(아이디/비밀번호) 암호화 키 (Fernet). 필수
DNS_CRYPTO_KEY=

# DMS API 기본 주소
DNS_API_BASE=https://api-dms.dsmhs.kr

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
DNS_LOG_LEVEL=INFO
